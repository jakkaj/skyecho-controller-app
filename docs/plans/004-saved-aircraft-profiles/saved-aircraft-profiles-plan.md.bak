// test/widget/profiles_screen_test.dart
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:tactical_radar/models/aircraft_profile.dart';
import 'package:tactical_radar/services/profile_repository.dart';
import 'package:tactical_radar/screens/profiles_screen.dart';

void main() {
  late ProfileRepository repository;

  setUp(() async {
    SharedPreferences.setMockInitialValues({});
    repository = ProfileRepository();
    await repository.init();
  });

  testWidgets('given_two_profiles_when_screen_loads_then_displays_both', (tester) async {
    /*
    Test Doc:
    - Why: Validate core UI rendering (AC #2 - profile list display)
    - Contract: ProfilesScreen displays all profiles from repository in list view
    - Usage Notes: Screen listens to repository changes; automatically refreshes on mutations
    - Quality Contribution: Catches UI rendering bugs; documents expected list behavior
    - Worked Example: 2 profiles in storage → screen shows 2 ListTile widgets
    */

    // Arrange
    await repository.save(AircraftProfile(
      id: '1',
      hex: 'ABC123',
      callsign: 'VH-ABC',
      createdAt: DateTime.now(),
      updatedAt: DateTime.now(),
    ));
    await repository.save(AircraftProfile(
      id: '2',
      hex: 'DEF456',
      callsign: 'VH-DEF',
      createdAt: DateTime.now(),
      updatedAt: DateTime.now(),
    ));

    // Act
    await tester.pumpWidget(MaterialApp(home: ProfilesScreen()));
    await tester.pumpAndSettle();

    // Assert
    expect(find.text('VH-ABC'), findsOneWidget);
    expect(find.text('VH-DEF'), findsOneWidget);
    expect(find.text('ABC123'), findsOneWidget);
    expect(find.text('DEF456'), findsOneWidget);
  });

  testWidgets('given_duplicate_hex_when_saving_then_shows_error_snackbar', (tester) async {
    /*
    Test Doc:
    - Why: Validate error feedback for duplicate hex (AC #11)
    - Contract: Attempting to save duplicate hex shows SnackBar with actionable hint
    - Usage Notes: Catch DuplicateHexError in save handler, show SnackBar message
    - Quality Contribution: Ensures user gets clear feedback on validation errors
    - Worked Example: Save hex='ABC123' → success; Save hex='ABC123' again → SnackBar appears
    */

    // Arrange
    await repository.save(AircraftProfile(
      id: '1',
      hex: 'ABC123',
      callsign: 'VH-ABC',
      createdAt: DateTime.now(),
      updatedAt: DateTime.now(),
    ));

    await tester.pumpWidget(MaterialApp(home: ProfilesScreen()));
    await tester.pumpAndSettle();

    // Act - Tap add button
    await tester.tap(find.byIcon(Icons.add));
    await tester.pumpAndSettle();

    // Fill form with duplicate hex
    await tester.enterText(find.byKey(Key('callsign_field')), 'VH-XYZ');
    await tester.enterText(find.byKey(Key('hex_field')), 'ABC123'); // Duplicate
    await tester.tap(find.text('Save'));
    await tester.pumpAndSettle();

    // Assert
    expect(find.byType(SnackBar), findsOneWidget);
    expect(find.textContaining('already exists'), findsOneWidget);
  });
}
```

